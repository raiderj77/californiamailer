# Browser Firebase app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credential. Supply JSON directly or base64 encoded.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative split credential fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Only this verified email (or a Firebase token with admin=true) can use owner APIs.
OWNER_EMAIL=

# Payments remain off until the owner completes the activation checklist.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional reservation notices and optional consumer verification.
# Public quote intake is stored for manual CRM review and does not send email.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Required before any commercial outreach or consumer email.
BUSINESS_POSTAL_ADDRESS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRACKING_HASH_SECRET=
CONSUMER_EMAIL_ENABLED=false

# Optional server-only coupon drafting. Manual coupon drafting works while disabled.
# Never prefix the API key with NEXT_PUBLIC_. The model override is optional.
AI_COUPON_GENERATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_COUPON_MODEL=gpt-5.6-luna
# Per paid reservation, per UTC day. Invalid values fall back to 5; code caps this at 10.
AI_COUPON_DAILY_QUOTA=5
